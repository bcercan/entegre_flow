{
  "name": "entegreflow",
  "version": "0.0.0",
  "private": true,
  "description": "EntegreFlow — AI Satış & Teklif Asistanı (multi-tenant SaaS)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}\"",
    "firewall": "depcruise --config .dependency-cruiser.cjs packages apps",
    "db:generate": "pnpm --filter @entegreflow/db generate",
    "db:migrate": "pnpm --filter @entegreflow/db migrate",
    "db:seed": "pnpm --filter @entegreflow/db seed",
    "dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@entegreflow/config": "workspace:*",
    "@eslint/js": "^9.17.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "tsx": "^4.19.2"
  }
}
