# ==============================================================================
# EntegreFlow — environment contract (committed). Copy to .env for local dev.
# On Coolify, set these per-Application/Resource in the UI (encrypted at rest).
#
# SERVICE SCOPING (security): secrets are NOT shared across all services.
#   [api]    needs: DB(runtime), REDIS, KEK, JWT, S3, ANTHROPIC, WEB_ORIGIN
#   [worker] needs: DB(runtime), REDIS, KEK, S3, ANTHROPIC
#   [web]    needs: NEXT_PUBLIC_* only  (NEVER the KEK or ANTHROPIC key)
#   [migrate] needs: DATABASE_MIGRATION_URL only
# ==============================================================================

NODE_ENV=development
LOG_LEVEL=debug

# ---- Database ---------------------------------------------------------------
# Runtime role: NON-superuser, NON-BYPASSRLS. Used by api + worker. RLS applies.
# (Dev host port is 5433 to avoid clashing with other local Postgres instances.)
DATABASE_URL=postgres://entegreflow_app:app_pw@localhost:5544/entegreflow
# Migration/owner role: has DDL rights. Used ONLY by the migrate step.
DATABASE_MIGRATION_URL=postgres://entegreflow_owner:owner_pw@localhost:5544/entegreflow

# ---- Redis (BullMQ) ---------------------------------------------------------
REDIS_URL=redis://localhost:6390

# ---- Secret encryption (KEK) ------------------------------------------------
# [api][worker] ONLY. base64-encoded 32 bytes (AES-256). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this up OUT-OF-BAND, separate from DB backups. Rotating it needs DEK rewrap.
APP_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
APP_ENCRYPTION_KEY_ID=kek-1

# ---- Auth / JWT -------------------------------------------------------------
# [api] ONLY. base64 secrets. Access token short-lived; refresh rotated.
JWT_ACCESS_SECRET=CHANGE_ME_base64_secret
JWT_ISSUER=entegreflow
JWT_AUDIENCE=entegreflow-web
JWT_ACCESS_TTL=600          # seconds (~10 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)
COOKIE_DOMAIN=localhost     # parent registrable domain in prod, e.g. example.com

# ---- Object storage (attachments / quote PDFs) -----------------------------
# [api][worker]. MinIO locally; external S3 (R2/B2) in prod is preferred.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=entegreflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ---- AI provider (Anthropic Claude) ----------------------------------------
# [api][worker] ONLY. Confirm model id/limits against live Claude API docs.
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=2048
# Per-tenant guard rails (fail-closed). Daily token budget across analysis jobs.
AI_DAILY_TOKEN_BUDGET=2000000

# ---- HTTP / CORS ------------------------------------------------------------
API_PORT=3001
WORKER_HEALTH_PORT=3002
WEB_ORIGIN=http://localhost:3000   # [api] CORS + Origin/Referer allowlist

# ---- Observability ----------------------------------------------------------
SENTRY_DSN=

# ---- Web (public — safe to expose to the browser) --------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=tr

# ---- Mail (local dev SMTP catcher) -----------------------------------------
# Mailpit captures outbound mail in dev so nothing leaves the machine.
DEV_SMTP_HOST=localhost
DEV_SMTP_PORT=1026
# Mailpit web UI: http://localhost:8026
