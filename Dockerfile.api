# syntax=docker/dockerfile:1
# ---- EntegreFlow API (NestJS) — multi-stage, non-root runtime ----------------

FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

# ---- builder: install + build api and its workspace deps --------------------
FROM base AS builder
COPY . .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
RUN pnpm build --filter @entegreflow/api...
# Produce a self-contained, prod-only deployment (workspace deps → their dist).
RUN pnpm --filter @entegreflow/api deploy --prod /app/deploy

# ---- runner: minimal runtime image ------------------------------------------
FROM node:22-slim AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder --chown=node:node /app/deploy ./
USER node
EXPOSE 3001
# Migrations run as a separate pre-deploy hook (not here) — see infra docs.
CMD ["node", "dist/main.js"]
